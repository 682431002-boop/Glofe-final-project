# Copy this file to backend/.env and fill in real values.   cp .env.example .env
# NEVER commit .env (it is listed in .gitignore). This example contains placeholders only.

NODE_ENV=development
PORT=4000

# --- MySQL (use the least-privileged app user you created, NOT root) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=glofe_app
DB_PASSWORD=put-your-database-password-here
DB_NAME=glofe

# --- Sessions ---
# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=glofe.sid
SESSION_TTL_HOURS=168

# --- Browser app origin(s) allowed to call the API with cookies (comma-separated) ---
# Development: the Vite dev server. Production: your real https:// site address.
CLIENT_ORIGIN=http://localhost:5173

# --- Security / behaviour ---
BCRYPT_ROUNDS=12
# Number of reverse proxies in front of Node in production (e.g. 1 behind nginx/Render/Railway). 0 = none.
TRUST_PROXY=0
# Pre-order deadlines are whole days evaluated in this timezone.
BUSINESS_TIMEZONE=Asia/Bangkok
